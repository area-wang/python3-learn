# 复制为 .env 后按需修改；所有变量都带 BLOG_ 前缀（见 app/core/config.py）
BLOG_APP_NAME="Blog API"
BLOG_DEBUG=false
BLOG_DATABASE_URL=sqlite:///./blog.db
# 生产环境务必替换，可用：python -c "import secrets; print(secrets.token_hex(32))"
BLOG_SECRET_KEY=dev-only-secret-key-change-me-in-production
BLOG_ACCESS_TOKEN_EXPIRE_MINUTES=30
# 列表类型用 JSON 写法
BLOG_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
